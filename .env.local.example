# Copy to .env.local and fill in once the Supabase project exists.
# Until these are set, the public site runs on placeholder demo data
# (lib/placeholder-data.ts) and the dashboard shows a "not connected" notice.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used for canonical URLs, OG tags, sitemap.xml and robots.txt.
SITE_URL=http://localhost:3000
